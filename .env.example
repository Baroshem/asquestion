# HTTP server
NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# Nitro filesystem storage directory (relative to project root or absolute)
DATA_DIR=./.data

# Optional external storage (automatically selected on Vercel)
# Install/configure an Upstash Redis integration and set these environment values.
# STORAGE_DRIVER=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Vercel integration projects may prefix them, for example:
# STORAGE_APP_KV_REST_API_URL=
# STORAGE_APP_KV_REST_API_TOKEN=
